# Copy to backend/.env and adjust.

# Where quote requests are stored (SQLite file)
DATABASE_PATH=./data/usm_bekway.db

# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Token for GET /api/quotes (header: X-Admin-Token). Leave empty to disable listing.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Max quote requests per client IP per hour
RATE_LIMIT_PER_HOUR=10

# Optional: e-mail each new quote request to the sales team
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
NOTIFY_FROM=
NOTIFY_TO=
